# Deliberately empty. Every component calls fetch(`${process.env.REACT_APP_API_URL}/api/...`).
# With this set to nothing, that becomes a plain relative "/api/..." call -
# which nginx (see nginx.conf) already proxies to the right microservice.
# Without this file, REACT_APP_API_URL is undefined, and every fetch call
# in the app literally requests "undefined/api/..." and silently fails -
# this was the real cause of the empty product list / "images not loading".
REACT_APP_API_URL=
