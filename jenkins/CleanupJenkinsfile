// ============================================================================
// ClickNCart RETIRED VERSION CLEANUP - scheduled, NOT push-triggered.
//
// Configure this as a SEPARATE Jenkins pipeline job from the main one,
// with a cron Build Trigger (e.g. "H */4 * * *" - roughly every 4 hours),
// not a GitHub webhook. This is what actually finishes the bounded-window
// promise: the main Jenkinsfile only ever ADDS entries to retiredVersions
// (see its Promote stage) - it deliberately never removes them, since
// nothing time-based should live inside a pipeline that only runs on push.
// This file is the other half.
// ============================================================================

pipeline {
    agent { label 'dedicated-jenkins' }

    environment {
        RETIREMENT_WINDOW_HOURS = '36'   // pick anywhere in your 24-48h range
    }

    stages {
        stage('Expire retired versions past their window') {
            steps {
                script {
                    def services = ['user-service', 'catalog-service', 'order-service', 'frontend']

                    for (svc in services) {
                        def retiredJson = sh(
                            script: "helm get values ${svc} -o json | jq -c '.retiredVersions'",
                            returnStdout: true
                        ).trim()

                        // Ask jq to do the actual date-window filtering -
                        // keep only entries NEWER than the cutoff; anything
                        // older gets dropped from the list we're about to
                        // write back. This is the "helm deletes it because
                        // it's no longer declared" mechanism from
                        // docs/PHASE_BLUEGREEN.md, fired here on a timer
                        // instead of inline in a release.
                        def stillWithinWindow = sh(
                            script: """
                                echo '${retiredJson}' | jq -c \\
                                  --arg cutoff "\$(date -u -d '-${env.RETIREMENT_WINDOW_HOURS} hours' +%Y-%m-%dT%H:%M:%SZ)" \\
                                  '[.[] | select(.retiredAt > \$cutoff)]'
                            """,
                            returnStdout: true
                        ).trim()

                        if (stillWithinWindow != retiredJson) {
                            echo "${svc}: at least one retired version has passed the ${env.RETIREMENT_WINDOW_HOURS}h window - expiring it now."
                            sh """
                                helm upgrade ${svc} ./helm/${svc} \\
                                    --reuse-values \\
                                    --set-json 'retiredVersions=${stillWithinWindow}'
                            """
                        } else {
                            echo "${svc}: nothing past the window yet - no change."
                        }
                    }
                }
            }
        }
    }
}
