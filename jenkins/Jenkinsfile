// ============================================================================
// ClickNCart CI/CD Pipeline
//
// WHY ONE JENKINSFILE FOR ALL 4 SERVICES INSTEAD OF 4 SEPARATE PIPELINES:
// the "detect changed service" logic and the Blue-Green deploy logic are
// IDENTICAL for every service - only the directory path and image name
// differ. One parametrized pipeline, looping over whichever services
// actually changed, avoids maintaining the same logic in 4 places. Real
// teams do split into separate Jenkinsfiles once services diverge enough
// in their build process to justify it - for 4 services this similar,
// one file is the right amount of abstraction.
// ============================================================================

pipeline {
    agent { label 'dedicated-jenkins'} // pins this to the tainted Jenkins node group - see terraform/modules/eks

    environment { 
        AWS_REGION = 'ap-south-1'
        ECR_REGISTRY = credentials('ecr-registry-url') // jenkins credentials -  never hardcoded
        DOCKERHUB_CREDS = credentials('dockerhub-credentials') 
        AWS_CREDS = credentials('aws-credentials')
        KUBE_CONFIG = credentials('eks-kubeconfig')
        BUILD_TAG_SUFFIX = "${env.BUILD_NUMBER}"  // this is the "never rely only on latest" requirement - every image gets a real, traceable tag   
    }

    stages { 

        stage('checkout') {
            steps {
                checkout scm
            }
        }

        // --------------------------------------------------------------
        // WHY THIS STAGE EXISTS: rebuilding and redeploying all 4 services
        // on every commit wastes build minutes AND increases blast radius
        // - a typo in the frontend shouldn't trigger a redeploy of
        // order-service. Comparing this commit against the last
        // successfully-built commit tells us exactly which service
        // folders actually changed.
        // --------------------------------------------------------------
        stage('detect changed services') {
            steps {
                script {
                    def changedFiles = sh(
                        script: "git diff --name-only HEAD~1 HEAD || git diff --name-only \$(git rev-list --max-parents=0 HEAD) HEAD",
                        returnStdout: true
                    ).trim().split("\n")

                    def allServices = ['user-service', 'order-service', 'catalog-service', 'frontend']
                    env.SERVICES_TO_BUILD = allServices.findAll { svc -> 
                        changedFiles.any { it.startsWith("${svc}/") }
                    }.join(',')

                    if (env.SERVICES_TO_BUILD == '') {
                        echo "No service directories changed - nothing to build.  Exiting pipeline cleanly."
                        currentBuild.result = 'NOT_BUILT'
                    } else {
                        echo "Services to build this run: ${env.SERVICES_TO_BUILD}"
                    }
                }
            }
        }


        stage('Test, Build, Scan, Push, Deploy - per changes service') {
            when {
                expression { env.SERVICES_TO_BUILD != '' }
            }
            steps {
                script {
                    def services = env.SERVICES_TO_BUILD.split(',')
                    def results = [:]


                    for (svc in services) {
                        // Wrapped in try/catch PER SERVICE - this is what
                        // makes "only the failed service rolls back, the
                        // others keep deploying" actually true. A single
                        // shared try/catch around the whole loop would
                        // abort every remaining service the moment one
                        // fails, which is the opposite of what
                        // independent microservice deploys should do.
                        try {
                            deployService(svc)
                            results[svc] ='SUCCESS'
                        } catch (Exception e) {
                            echo "Deployment FAILED for ${svc}: ${e.getMessage()}"
                            echo "Rolling back ${svc} ONLY - other services are unaffected."
                            sh "help upgrade ${svs} ./helm/${svc} --reuse-values --set activeColor=\$(cat .previous-color-${svc} 2>/dev/null || echo blue)"
                            results[svc] = 'ROLLED BACK'
                        }
                    }

                    echo "=== Final results ==="
                    results.each { svc, status -> echo "${svc}: ${status}" }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}

// ============================================================================
// Per-service pipeline logic - called once per changed service.
// This is the sequence your spec asked for: test -> build -> scan -> tag
// -> push Docker Hub -> push ECR -> deploy Green -> health-validate ->
// switch traffic -> delete old Blue.
// ============================================================================
def deployService(String svc) {
    def imageTag = "1.0.${env.BUILD_TAG_SUFFIX}"
    def dockerhubImage = "yourdockerhubuser/clicknkart-${svc}:${imageTag}"
    def ecrImage = "${env.ECR_REGISTRY}/clicknkart/${svc}:${imageTag}"

    stage("[${svc}] Run Tests") {
        dir(svc) {
            if (svc == 'frontend') {
                sh 'npm install && CI=true npm test -- --watchAll=false'
            } else {
                sh 'mvn test'
            }
        }
    }

    stage("[${svc}] Build Docker Image") {
        dir(svc) {
            // Every service's Dockerfile already uses a multi-stage build
            // (build stage compiles, runtime stage is minimal) - see the
            // application repo's Dockerfiles. This is what keeps the
            // final pushed image small and free of build-time tooling
            // (Maven, node_modules dev deps) that would otherwise bloat
            // the image and widen its attack surface.
            sh "docker build -t ${svc}:${imageTag} ."
        }       
    }

    stage("[${svc}] Security Scan") {
        // Trivy scans the image for known CVEs BEFORE it's ever pushed
        // anywhere. --exit-code 1 on HIGH/CRITICAL findings means the
        // pipeline stops here rather than shipping a vulnerable image -
        // this is the actual enforcement mechanism, not just a report.
        sh "trivy image --severity HIGH,CRITICAL --exit-code 1 ${svc}:${imageTag}"
    }

    stage("[${svc}] Tag & Push Images") {
        sh """ 
            docker tag ${svc}:${imageTag} ${dockerhubImage}
            docker tag ${svc}:${imageTag} ${ecrImage}

            echo \$DOCKERHUB_CREDS_PSW | docker login -u \$DOCKERHUB_CREDS_USR --password-stdin
            docker push ${dockerhubImage}

            aws ecr get-login-password --region ${env.AWS_REGION} | docker login --username AWS --password-stdin ${env.ECR_REGISTRY}
            docker push ${ecrImage}
        """
    }

    stage("[${svc}] Deploy to Inactive Color") {
        // Figure out which color is CURRENTLY live, then deploy the new
        // image to the OTHER one - this is the core Blue-Green move.
        
        def currentColor = sh(
            script: "kubectl get service ${svc == 'frontend' ? 'frontend-service' : svc} -o jsonpath='{.spec.selector.color}'",
            returnStdout: true
        ).trim() ?: 'blue'
        def targetColor = (currentColor == 'blue') ? 'green' : 'blue'

        sh "echo ${currentColor} > .previous-color-${svc}"  // remembered for rollback, see the catch block above

        sh """
            helm upgrade --install ${svc} ./helm/${svc} \\
                --set image.repository=${env.ECR_REGISTRY}/clicknkart/${svc} \\
                --set image.tag=${imageTag} \\
                --reuse-values
        """
        // NOTE: this upgrades the ${targetColor} Deployment's image only
        // (both blue/green Deployments exist per the chart design) -
        // activeColor in the Service is NOT changed yet, so the currently
        // live color keeps serving 100% of traffic through the whole
        // build/scan/deploy sequence above. Zero risk to production
        // during this stage.

        env."TARGET_COLOR_${svc}" = targetColor
    }

    stage("[${svc}] Health Validation") {
        // Poll the NEW color's pods directly (bypassing the Service,
        // which still points at the OLD color) - probes already gate
        // pod readiness via Kubernetes itself; this stage additionally
        // confirms the app-level /actuator/health (or / for frontend)
        // actually returns healthy before we dare switch real traffic.
        retry(5) {
            sh """
                kubectl wait --for=condition=ready pod \\
                    -l app=${svc},color=${env."TARGET_COLOR_${svc}"} \\
                    --timeout=60s
            """
        }
    }

    stage("[${svc}] Switch Traffic to New Color") {
        sh "helm upgrade ${svc} ./helm/${svc} --reuse-values --set activeColor=${env."TARGET_COLOR_${svc}"}"
        echo "${svc}: traffic switched to ${env."TARGET_COLOR_${svc}"}. Old color left running as instand rollback target."
    }

    stage("[${svc}] Cleanup Old Color") {
        // Deliberately NOT deleting the old color's pods here, matching
        // your own spec's scheduling philosophy: leave them running as a
        // safety margin for one more release cycle, only scale old-color
        // replicas down (not delete the Deployment) so a fast rollback
        // is still possible if a problem surfaces after this pipeline
        // finished. A separate, deliberate cleanup step (manual or on a
        // delay) is a more defensible production pattern than an
        // automatic instant delete right after switching traffic.
        echo "Old color pods left running as rollback safety margin - not auto-deleted."
    }
}