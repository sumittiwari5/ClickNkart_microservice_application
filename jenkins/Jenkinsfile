// ============================================================================
// ClickNCart CI/CD Pipeline
//
// Replaces the old fixed blue/green color-flip with incrementally
// versioned Deployments (catalog-service-v1, -v2, -v3...). See
// docs/PHASE_BLUEGREEN.md for the full reasoning. This file only handles
// deploy + promote; actually DELETING an old version is deliberately NOT
// here - see jenkins/CleanupJenkinsfile, a separate scheduled pipeline.
// ============================================================================


pipeline {
    agent { label 'dedicated-jenkins'} // pins this to the tainted Jenkins node group - see terraform/modules/eks

    environment { 
        AWS_REGION = 'ap-south-1'
        ECR_REGISTRY = credentials('ecr-registry-url') // jenkins credentials -  never hardcoded
        DOCKERHUB_CREDS = credentials('dockerhub-credentials') 
        AWS_CREDS = credentials('aws-credentials')
        KUBE_CONFIG = credentials('eks-kubeconfig')
        BUILD_TAG_SUFFIX = "${env.BUILD_NUMBER}"  // this is the "never rely only on latest" requirement - every image gets a real, traceable tag   
    }

    stages { 

        stage('checkout') {
            steps {
                checkout scm
            }
        }

        // --------------------------------------------------------------
        // WHY THIS STAGE EXISTS: rebuilding and redeploying all 4 services
        // on every commit wastes build minutes AND increases blast radius
        // - a typo in the frontend shouldn't trigger a redeploy of
        // order-service. Comparing this commit against the last
        // successfully-built commit tells us exactly which service
        // folders actually changed.
        // --------------------------------------------------------------
        stage('Detect Changed Services') {
            steps {
                script {
                    def changedFiles = sh(
                        script: "git diff --name-only HEAD~1 HEAD || git diff --name-only \$(git rev-list --max-parents=0 HEAD) HEAD",
                        returnStdout: true
                    ).trim().split("\n")

                    def allServices = ['user-service', 'order-service', 'catalog-service', 'frontend']
                    env.SERVICES_TO_BUILD = allServices.findAll { svc -> 
                        changedFiles.any { it.startsWith("${svc}/") }
                    }.join(',')

                    if (env.SERVICES_TO_BUILD == '') {
                        echo "No service directories changed - nothing to build.  Exiting pipeline cleanly."
                        currentBuild.result = 'NOT_BUILT'
                    } else {
                        echo "Services to build this run: ${env.SERVICES_TO_BUILD}"
                    }
                }
            }
        }


        stage('Test, Build, Scan, Push, Deploy - per changes service') {
            when {
                expression { env.SERVICES_TO_BUILD != '' }
            }
            steps {
                script {
                    def services = env.SERVICES_TO_BUILD.split(',')
                    def results = [:]


                    for (svc in services) {
                        // Wrapped in try/catch PER SERVICE - this is what
                        // makes "only the failed service rolls back, the
                        // others keep deploying" actually true. A single
                        // shared try/catch around the whole loop would
                        // abort every remaining service the moment one
                        // fails, which is the opposite of what
                        // independent microservice deploys should do.
                        try {
                            deployService(svc)
                            results[svc] ='SUCCESS - promoted to live'
                        } catch (Exception e) {
                            echo "Deployment FAILED for ${svc}: ${e.getMessage()}"
                            echo "Rolling back ${svc} ONLY - other services are unaffected."
                            echo "Aborting the candidate for ${svc} ONLY - live version is untouched, other services are unaffected."
                            abortCandidate(svc)
                            results[svc] = 'ABORTED - candidate rolled back, live version never touched'
                        }
                    }

                    echo "=== Final results ==="
                    results.each { svc, status -> echo "${svc}: ${status}" }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}

// ============================================================================
// Per-service deploy logic: build -> scan -> push -> deploy CANDIDATE ->
// health-validate -> PROMOTE candidate to live (old live becomes retired).
// Note this is a meaningfully different shape than the old blue/green
// version: there's no "switch to the other fixed-name object" step -
// instead, the version NUMBERS themselves shift roles.
// ============================================================================
def deployService(String svc) {
    def imageTag = "1.0.${env.BUILD_TAG_SUFFIX}"
    def dockerhubImage = "yourdockerhubuser/clicknkart-${svc}:${imageTag}"
    def ecrImage = "${env.ECR_REGISTRY}/clicknkart/${svc}:${imageTag}"

    stage("[${svc}] Run Tests") {
        dir(svc) {
            if (svc == 'frontend') {
                sh 'npm install && CI=true npm test -- --watchAll=false'
            } else {
                sh 'mvn test'
            }
        }
    }

    stage("[${svc}] Build Docker Image") {
        dir(svc) {
            // Every service's Dockerfile already uses a multi-stage build
            // (build stage compiles, runtime stage is minimal) - see the
            // application repo's Dockerfiles. This is what keeps the
            // final pushed image small and free of build-time tooling
            // (Maven, node_modules dev deps) that would otherwise bloat
            // the image and widen its attack surface.
            sh "docker build -t ${svc}:${imageTag} ."
        }       
    }

    stage("[${svc}] Security Scan") {
        // Trivy scans the image for known CVEs BEFORE it's ever pushed
        // anywhere. --exit-code 1 on HIGH/CRITICAL findings means the
        // pipeline stops here rather than shipping a vulnerable image -
        // this is the actual enforcement mechanism, not just a report.
        sh "trivy image --severity HIGH,CRITICAL --exit-code 1 ${svc}:${imageTag}"
    }

    stage("[${svc}] Tag & Push Images") {
        sh """ 
            docker tag ${svc}:${imageTag} ${dockerhubImage}
            docker tag ${svc}:${imageTag} ${ecrImage}

            echo \$DOCKERHUB_CREDS_PSW | docker login -u \$DOCKERHUB_CREDS_USR --password-stdin
            docker push ${dockerhubImage}

            aws ecr get-login-password --region ${env.AWS_REGION} | docker login --username AWS --password-stdin ${env.ECR_REGISTRY}
            docker push ${ecrImage}
        """
    }

    stage("[${svc}] Deploy Candidate Version") {
        // Read the CURRENT liveVersion straight off the real Helm release,
        // not off a locally-remembered value - this is what keeps the
        // pipeline correct even if a manual `helm upgrade` happened
        // outside the pipeline since the last run.
        
        def currentLive = sh(
            script: "helm get values ${svc} -o json | jq -r '.liveVersion'",
            returnStdout: true
        ).trim().toInteger()

        nextVersion = currentLive + 1
        env."CANDIDATE_VERSION_${svc}" = nextVersion.toString()

        sh """
            helm upgrade ${svc} ./helm/${svc} \\
                --reuse-values \\
                --set candidateVersion=${nextVersion} \\
                --set imageTags.v${nextVersion}=${env.ECR_REGISTRY}/clickncart/${svc}:${imageTag} \\
                --set image.repository=${env.ECR_REGISTRY}/clickncart/${svc}
        """
        // NOTE: liveVersion is untouched here - the Service still routes
        // 100% traffic to the old live version through this entire stage
        // and the health check below. Zero risk to production so far.
    }

    stage("[${svc}] Health Validation") {
        retry(5) {
            sh """
                kubectl wait --for=condition=ready pod \\
                    -l app=${svc},version=v${nextVersion} \\
                    --timeout=60s
            """
        }
    }

    stage("[${svc}] Promote Candidate to Live") {
        def previousLive = sh(
            script: "helm get values ${svc} -o json | jq -r '.liveVersion'",
            returnStdout: true
        ).trim()

        def retiredAt = sh(script: "date -u +%Y-%m-%dT%H:%M:%SZ", returnStdout: true).trim()

        // Build the NEW retiredVersions list explicitly: existing entries
        // (there may already be one or more, if an earlier retired
        // version hasn't been cleaned up yet - that's expected, see
        // docs/PHASE_BLUEGREEN.md) PLUS the version that's retiring right
        // now. jq constructs this as one clean JSON array; --set-json
        // then replaces the whole list atomically in one helm upgrade -
        // no partial/conflicting state possible.
        def updatedRetiredList = sh(
            script: """
                helm get values ${svc} -o json | jq -c \\
                  --arg v "${previousLive}" --arg t "${retiredAt}" \\
                  '.retiredVersions + [{"version": (\$v|tonumber), "retiredAt": \$t}]'
            """,
            returnStdout: true
        ).trim()

        // This ONE command is the entire traffic switch: liveVersion moves
        // to the new version (flips the Service selector), the OLD live
        // version is now IN retiredVersions with a timestamp (starts its
        // bounded rollback window), and candidateVersion is cleared
        // (nothing "in progress" anymore).
        sh """
            helm upgrade ${svc} ./helm/${svc} \\
                --reuse-values \\
                --set liveVersion=${nextVersion} \\
                --set candidateVersion=null \\
                --set-json 'retiredVersions=${updatedRetiredList}'
        """
        echo "${svc}: v${nextVersion} is now live. v${previousLive} retired at ${retiredAt} - kept as rollback margin until jenkins/CleanupJenkinsfile expires it."
    }
}

// Called from the per-service catch block above. Since liveVersion is
// NEVER touched until the Promote stage succeeds, "rollback" at this
// point just means removing the half-deployed candidate - the real live
// version was never at risk in the first place. This is a meaningfully
// SAFER failure mode than the old design, worth noticing: a failed
// deploy here can't accidentally take down production, because
// production was never pointed at the new version to begin with.
def abortCandidate(String svc) {
    sh """
        helm upgrade ${svc} ./helm/${svc} \\
            --reuse-values \\
            --set candidateVersion=null
    """
}
