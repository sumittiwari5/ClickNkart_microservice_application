#!/bin/bash

set -e

echo "=========================================="
echo " ClickNCart DevOps Tool Installation"
echo "=========================================="

if [ "$EUID" -ne 0 ]; then
    echo "Please run this script with sudo:"
    echo "sudo ./install.sh"
    exit 1
fi

echo ""
echo "[1/8] Updating system packages..."
apt-get update -y
apt-get upgrade -y

echo ""
echo "[2/8] Installing basic dependencies..."
apt-get install -y \
    curl \
    wget \
    unzip \
    git \
    jq \
    unzip \
    gnupg \
    software-properties-common \
    ca-certificates \
    apt-transport-https \
    lsb-release \
    python3 \
    python3-pip \
    python3-venv

echo ""
echo "[3/8] Installing Terraform..."

if ! command -v terraform >/dev/null 2>&1; then

    wget -O- https://apt.releases.hashicorp.com/gpg \
        | gpg --dearmor \
        | tee /usr/share/keyrings/hashicorp-archive-keyring.gpg > /dev/null

    echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] \
https://apt.releases.hashicorp.com $(lsb_release -cs) main" \
        | tee /etc/apt/sources.list.d/hashicorp.list

    apt-get update -y
    apt-get install -y terraform

else
    echo "Terraform already installed."
fi

echo ""
echo "[4/8] Installing AWS CLI..."

if ! command -v aws >/dev/null 2>&1; then

    cd /tmp

    curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" \
        -o awscliv2.zip

    unzip -q -o awscliv2.zip

    ./aws/install

    rm -rf aws awscliv2.zip

else
    echo "AWS CLI already installed."
fi

echo ""
echo "[5/8] Installing Ansible..."

if ! command -v ansible >/dev/null 2>&1; then

    apt-get install -y ansible

else
    echo "Ansible already installed."
fi

echo ""
echo "[6/8] Installing kubectl..."

if ! command -v kubectl >/dev/null 2>&1; then

    curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"

    install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl

    rm -f kubectl

else
    echo "kubectl already installed."
fi

echo ""
echo "[7/8] Installing Helm..."

if ! command -v helm >/dev/null 2>&1; then

    curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 \
        | bash

else
    echo "Helm already installed."
fi

echo ""
echo "[8/8] Installing eksctl..."

if ! command -v eksctl >/dev/null 2>&1; then

    ARCH=amd64

    if [ "$(uname -m)" = "aarch64" ]; then
        ARCH=arm64
    fi

    PLATFORM="$(uname -s)_${ARCH}"

    curl --silent --location \
        "https://github.com/eksctl-io/eksctl/releases/latest/download/eksctl_${PLATFORM}.tar.gz" \
        | tar xz -C /tmp

    install -o root -g root -m 0755 /tmp/eksctl /usr/local/bin/eksctl

    rm -f /tmp/eksctl

else
    echo "eksctl already installed."
fi

echo ""
echo "=========================================="
echo " Installation completed"
echo "=========================================="

echo ""
echo "Installed versions:"
echo "------------------------------------------"

echo "Terraform:"
terraform version | head -n 1

echo ""
echo "AWS CLI:"
aws --version

echo ""
echo "Ansible:"
ansible --version | head -n 1

echo ""
echo "kubectl:"
kubectl version --client --output=yaml 2>/dev/null | grep gitVersion | head -n 1 || kubectl version --client

echo ""
echo "Helm:"
helm version --short

echo ""
echo "eksctl:"
eksctl version

echo ""
echo "Git:"
git --version

echo ""
echo "=========================================="
echo " All required management tools installed"
echo "=========================================="